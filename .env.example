# Copy to .env and fill in. Never commit .env.

# NEAR AI Cloud API key from https://cloud.near.ai/dashboard
NEARAI_API_KEY=

# Cloudflare credentials for deploys. The token needs Workers Scripts and R2 edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Storage service for Claims and Evidence (typescript/apps/storage)
STORAGE_URL=https://enzure-storage.luckzivanius.workers.dev

# Web app (typescript/apps/web), fixed at build time: the oracle contract it reads and calls,
# and the network. NEAR_RPC_URL, NEAR_TX_API_URL and NEAR_EXPLORER_URL are optional overrides.
ORACLE_ACCOUNT_ID=
NEAR_NETWORK=testnet

# NEAR testnet account the oracle scripts sign with, and a full-access key for it (ed25519:...)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Keeper service (typescript/apps/keeper): the oracle it watches. It signs with NEAR_ACCOUNT_ID / NEAR_PRIVATE_KEY.
ORACLE_ACCOUNT_ID=
# Optional: both turn the Keeper's Relayer on (Base Sepolia)
EVM_RPC_URL=
EVM_PRIVATE_KEY=
