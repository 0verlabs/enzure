# Copy to .env and fill in. Never commit .env.

# NEAR AI Cloud API key from https://cloud.near.ai/dashboard
NEARAI_API_KEY=

# Cloudflare credentials for deploys. The token needs Workers Scripts and R2 edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Storage service for Claims and Evidence (typescript/apps/storage)
STORAGE_URL=https://enzure-storage.luckzivanius.workers.dev

# The oracle contract and NEAR network, shared by the web app (typescript/apps/web, fixed at
# build time), which reads and calls it, and the Keeper service (typescript/apps/keeper), which
# watches it. NEAR_RPC_URL, NEAR_TX_API_URL and NEAR_EXPLORER_URL are optional web app overrides.
ORACLE_ACCOUNT_ID=
NEAR_NETWORK=testnet

# NEAR testnet account the oracle scripts sign with, and a full-access key for it (ed25519:...)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# EVM key and RPC for the scripts and the escrow demo (Base Sepolia): deploys and test transactions.
EVM_RPC_URL=
EVM_PRIVATE_KEY=

# Keeper service (typescript/apps/keeper): it signs NEAR calls with NEAR_ACCOUNT_ID / NEAR_PRIVATE_KEY.
# Optional, a pair per Relayer chain: an RPC and a key that pays that chain's gas for deliveries.
# Base: mainnet (8453) or Base Sepolia (84532), whichever the RPC serves.
BASE_RPC_URL=
BASE_RELAYER_KEY=
